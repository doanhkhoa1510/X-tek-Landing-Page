---
/* Subpages: a night head with Mount Zion's contours behind a two-tone title, then dawn hands over to daylight (the Dawn Rule). */
import Base from "./Base.astro";
import { brand } from "../data/site";

interface Props {
  title: string;
  description: string;
  a: string;
  b: string;
  lede?: string;
  meta?: string[];
  /** a line about the page itself, in the page's language (the English-only notice) */
  note?: string;
  /** the language of the title, lede, and meta when they fall back to English */
  lang?: string;
  /** false when the page body stays on night (contact) and closes its own limb */
  dawn?: boolean;
}
const { title, description, a, b, lede, meta = [], note, lang, dawn = true } = Astro.props;
const aside = !!lede || meta.length > 0 || !!note || Astro.slots.has("aside");
---
<Base title={`${title} · ${brand.name}`} description={description}>
  <section id="top" class:list={["page-head", { "no-dawn": !dawn }]} data-on="dark" aria-labelledby="page-title">
    <div class="page-topo" aria-hidden="true"><canvas></canvas></div>
    <div class="wrap page-head-grid">
      <h1 id="page-title" class="tt page-title" lang={lang}><span class="tt-a">{a}</span> <span class="tt-b">{b}</span></h1>
      {aside && (
        <div class="page-aside">
          {lede && <p class="page-lede" lang={lang}>{lede}</p>}
          <slot name="aside" />
          {(meta.length > 0 || note) && <ul class="page-meta">{meta.map((m) => <li lang={lang}>{m}</li>)}{note && <li>{note}</li>}</ul>}
        </div>
      )}
    </div>
    {dawn && <div class="horizon dawn page-dawn" aria-hidden="true"></div>}
  </section>

  <slot />

  <Fragment slot="script">
    <script>
      import "../scripts/page";
    </script>
  </Fragment>
</Base>
