---
import "@fontsource-variable/saira/wdth.css";
import "@fontsource-variable/martian-mono/wdth.css";
import "@fontsource-variable/host-grotesk";
import "@fontsource-variable/noto-sans-mono"; // IPA glyphs (ɒ, ː) for the pronunciation; the three brand faces lack them
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { defaultLocale, localeOf, locales, localize, unlocalize } from "../i18n/config";
import { useT } from "../i18n";

interface Props { title: string; description: string; home?: boolean }
const { title, description, home = false } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const t = useT(locale.code, "common");
// the same page in every language, for search engines; English doubles as the default (needs SITE_URL)
const path = unlocalize(Astro.url.pathname);
const abs = (p: string) => Astro.site && new URL(p, Astro.site).href;
// a language's script faces load only on its own pages (src/styles/locales/<locale>.css)
const sheets = import.meta.glob<string>("../styles/locales/*.css", { query: "?url", import: "default", eager: true });
const sheet = sheets[`../styles/locales/${locale.code}.css`];
---
<!doctype html>
<html lang={locale.code} dir={locale.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {Astro.site && (
    <>
      <link rel="canonical" href={abs(Astro.url.pathname)} />
      {locales.map((l) => <link rel="alternate" hreflang={l.code} href={abs(localize(path, l.code))} />)}
      <link rel="alternate" hreflang="x-default" href={abs(localize(path, defaultLocale))} />
    </>
  )}
  <meta name="theme-color" content="#030813" />
  <link rel="icon" href="/xiontechs-logo.png" />
  {sheet && <link rel="stylesheet" href={sheet} />}
  <script is:inline>document.documentElement.classList.add("js");</script>
</head>
<body>
  <a class="skip" href="#main">{t("skip")}</a>
  <slot name="stage" />

  <Header home={home} />

  <main id="main">
    <slot />
  </main>

  <Footer home={home} />
  <slot name="script" />
</body>
</html>
