---
/* 01 · Main: the four-line headline bottom-left, over the mountain; as the camera dives, what we do takes its place (#38). */
import { localize } from "../../i18n/config";
import { services } from "../../data/site";
import { useT } from "../../i18n";

const lang = Astro.currentLocale;
const t = useT(lang, "hero"), tc = useT(lang, "common"), ts = useT(lang, "site");
const lines = t("lines", { returnObjects: true });
---
<section id="top" class="hero" data-on="dark" aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">
        {lines.map((line) => <><span class="ln"><span>{line}</span></span>{" "}</>)}
        <span class="ln"><span class="accent">{t("accent")}</span></span>
      </h1>
      <p class="hero-lede">{t("lede")}</p>
      <div class="actions">
        <a class="btn btn-fill" href="#summit"><span class="scr">{tc("talk")}</span></a>
        <a class="btn btn-line" href={`${localize("/about-us/", lang)}#mindset`}><span class="scr">{t("mindset")}</span></a>
      </div>
    </div>
    <div class="hero-next">
      <p class="hero-next-label">{t("next.label")}</p>
      <ul class="hero-services">{services.map((id) => <li>{ts(`services.${id}.name`)}</li>)}</ul>
      <a class="btn btn-line" href="#work"><span class="scr">{t("next.link")}</span></a>
    </div>
    <div class="hero-dawn" aria-hidden="true"></div>
  </div>
</section>
