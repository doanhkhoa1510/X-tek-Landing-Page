---
/* About us · Core values: pinned; the value track slides past while the giant type drifts behind (story.ts). */
import { useT } from "../../i18n";
import { values } from "../../data/site";
import { localize } from "../../i18n/config";

const lang = Astro.currentLocale;
const t = useT(lang, "values"), tc = useT(lang, "common");
// app.ts fills {n} with the altitude reading
const alt = `${tc("hud.alt")} {n} ${tc("units.m")}`;
---
<section id="values" class="routes" data-on="light" aria-labelledby="values-title">
  <div class="routes-pin">
    <div class="routes-sky" aria-hidden="true">
      <p class="giant">{t("giant")}</p>
      <div class="ridge">
        <canvas></canvas>
        <div class="rider"><i></i><span class="rider-alt" data-tpl={alt}>{alt.replace("{n}", "0")}</span></div>
      </div>
    </div>
    <div class="routes-band" data-on="dark">
      <div class="routes-intro">
        <h2 id="values-title" class="tt"><span class="tt-a">{t("title.a")}</span> <span class="tt-b">{t("title.b")}</span></h2>
        <p>{t("intro")}</p>
        <a class="btn btn-line" href={localize("/contact-us/", lang)}><span class="scr">{tc("talk")}</span></a>
      </div>
      <div class="track-wrap">
      <ol class="track">
        {values.map(([id, icon]) => (
          <li class="svc">
            <span class="svc-icon" data-icon={icon}></span>
            <h3>{t(`items.${id}.name`)}</h3>
            <p class="svc-motto">{t(`items.${id}.motto`)}</p>
            <p>{t(`items.${id}.text`)}</p>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </div>
</section>
