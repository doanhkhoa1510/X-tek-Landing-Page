---
/* 04 · The log: customers, products, done, achieved (#33); the dial fills arc by arc as each entry is read (dial.ts). */
import { services } from "../../data/site";
import { useT } from "../../i18n";
import { localize } from "../../i18n/config";
import { publishedCases } from "../../i18n/content";

const lang = Astro.currentLocale;
const t = useT(lang, "work"), ts = useT(lang, "site"), tk = useT(lang, "cases");
// case studies show only once owner-approved and NDA-checked (#49); none are, so the entry shows the domains and the visit
const cases = (await publishedCases(lang)).slice(0, 3);
const stats = [["years", 25, "+"], ["pillars", 5, ""], ["offices", 3, ""]] as const;
const products = [{ id: "school", anchor: "smart-schools" }, { id: "timetabling", anchor: "timetabling" }] as const;
const domains = ["edtech", "healthcare", "logistics"] as const;
// clients the owner named in #20; names stay in Latin letters in every language. A project with no public detail
// shows its name only (owner's call), so `about: false` keeps any sentence off it
const clients = [
  { id: "varkey", name: "Varkey Education", projects: [{ id: "pxp", name: "PXP", about: true }, { id: "sxp", name: "SXP", about: false }, { id: "ess", name: "ESS", about: false }] },
  { id: "cyberhive", name: "Cyberhive", projects: [{ id: "diagnostic", name: "Cyber Diagnostic", about: true }, { id: "intel", name: "Threat Intel", about: true }] },
] as const;
---
<section id="work" class="ascent" data-on="light" aria-labelledby="work-title">
  <div class="ascent-bg" aria-hidden="true"><canvas></canvas></div>
  <div class="wrap ascent-grid">
    <div class="ascent-side">
      <div class="ascent-head">
        <h2 id="work-title" class="tt"><span class="tt-a">{t("title.a")}</span> <span class="tt-b">{t("title.b")}</span></h2>
        <p>{t("intro")}</p>
      </div>
      <div class="dial" aria-hidden="true">
        <div class="dial-frame">
          <svg></svg>
          <div class="dial-core"><b class="dial-num"><span class="dial-reel"></span></b><span class="dial-name"><span class="dial-reel"></span></span></div>
        </div>
      </div>
    </div>
    <ol class="stages">
      <li class="stage" data-camp={t("customers.camp")}>
        <span class="stage-icon" data-icon="cocreate"></span>
        <h3>{t("customers.title")}</h3>
        <p>{t("customers.text")}</p>
        <ul class="tags" aria-label={t("customers.domainsLabel")}>
          {domains.map((id) => <li>{t(`customers.domains.${id}`)}</li>)}
        </ul>
        <ul class="log clients" aria-label={t("customers.clientsLabel")}>
          {clients.map((c) => (
            <li>
              <h4>{c.name}</h4>
              <p>{t(`customers.clients.${c.id}.text`)}</p>
              <ul class="projects" aria-label={t("customers.projectsLabel", { client: c.name })}>
                {c.projects.map((p) => <li><b>{p.name}</b>{p.about && <span>{t(`customers.clients.${c.id}.projects.${p.id}`)}</span>}</li>)}
              </ul>
            </li>
          ))}
        </ul>
        {cases.length > 0 && (
          <ul class="cases" aria-label={tk("label")}>
            {cases.map(({ entry, slug }) => (
              <li><a href={localize(`/work/${slug}/`, lang)}><span class="label">{entry.data.client}</span><h4>{entry.data.title}</h4><p>{entry.data.result}</p><span class="cases-read">{tk("read")}</span></a></li>
            ))}
          </ul>
        )}
      </li>
      <li class="stage" data-camp={t("products.camp")}>
        <span class="stage-icon" data-icon="product"></span>
        <h3>{t("products.title")}</h3>
        <p>{t("products.text")}</p>
        <ul class="log">
          {products.map((p) => (
            <li>
              <h4><a class="log-link" href={localize(`/products/#${p.anchor}`, lang)}>{t(`products.items.${p.id}.name`)}</a></h4>
              <p>{t(`products.items.${p.id}.text`)}</p>
            </li>
          ))}
        </ul>
        <a class="cases-read stage-more" href={localize("/products/", lang)}>{t("products.details")}</a>
      </li>
      <li class="stage" data-camp={t("done.camp")}>
        <span class="stage-icon" data-icon="development"></span>
        <h3>{t("done.title")}</h3>
        <p>{t("done.text")}</p>
        <ul class="log">
          {services.map((id) => <li><h4>{ts(`services.${id}.name`)}</h4><p>{ts(`services.${id}.text`)}</p></li>)}
        </ul>
      </li>
      <li class="stage" data-camp={t("achieved.camp")}>
        <span class="stage-icon" data-icon="clock"></span>
        <h3>{t("achieved.title")}</h3>
        <p>{t("achieved.text")}</p>
        <dl class="stats stage-stats">
          {stats.map(([id, n, unit]) => <div class="stat"><dt>{t(`achieved.stats.${id}`)}</dt><dd><span data-count={n}>{n}</span>{unit}</dd></div>)}
        </dl>
      </li>
    </ol>
  </div>
</section>
