---
import { brand, mark, phones, sections } from "../data/site";
import LangSwitch from "./LangSwitch.astro";
import { localize, unlocalize } from "../i18n/config";
import { useT } from "../i18n";

interface Props { home?: boolean }
const { home = false } = Astro.props;
const lang = Astro.currentLocale;
const t = useT(lang, "header"), ts = useT(lang, "site"), tc = useT(lang, "common"), tf = useT(lang, "footer");
// on the landing page the sections are in-page anchors; elsewhere they lead back to it
const to = (id: string) => (home ? `#${id}` : `${localize("/", lang)}#${id}`);
const pages = [["/products/", "products"], ["/about-us/", "about"], ["/careers/", "careers"], ["/support/", "support"]] as const;
// wide screens show the sections in the row; Contact stays with the CTA, which goes there
const inline = sections.filter((id) => id !== "summit");
const here = unlocalize(Astro.url.pathname);
---
<header class="hdr" data-on="dark">
  <div class="ticker">
    <p class="ticker-clocks">
      <span><span class="t-long">{ts("cities.plano.name")}</span><span class="t-short">{ts("cities.plano.short")}</span> <b data-clock="America/Chicago">--:--</b> CT</span>
      <span><span class="t-long">{ts("cities.hcmc.name")}</span><span class="t-short">{ts("cities.hcmc.short")}</span> <b data-clock="Asia/Ho_Chi_Minh">--:--</b> ICT</span>
    </p>
    <div class="ticker-end">
      <p class="ticker-links">
        <a href={phones.us.href}><span class="scr">{tc("call", { phone: phones.us.label })}</span></a>
        <a href={phones.wa.href} target="_blank" rel="noopener"><span class="scr">{tc("whatsapp", { phone: phones.wa.label })}</span></a>
      </p>
      <LangSwitch variant="menu" />
    </div>
  </div>
  <div class="hdr-row">
    <a class="logo" href={home ? "#top" : localize("/", lang)} aria-label={t(home ? "logoTop" : "logoHome", { brand: brand.name, say: brand.say })}>
      <svg class="logo-mark" viewBox="0 30 294 162" aria-hidden="true" set:html={mark}></svg>
      <span class="name">
        <span class="logo-word" aria-hidden="true"><span>X</span><span class="fold"><span>ion</span></span><span>T</span><span class="fold"><span>ech</span></span></span>
        <span class="say" aria-hidden="true">{brand.ipa}</span>
      </span>
    </a>
    <div class="hdr-mid">
      <nav class="hdr-nav" aria-label={t("primary")}>
        {inline.map((id) => <a href={to(id)} data-section={id}><span class="scr">{ts(`sections.${id}`)}</span></a>)}
      </nav>
      <div class="menu">
        <button class:list={["menu-toggle", { "is-here": pages.some(([href]) => here.startsWith(href)) }]} type="button" aria-expanded="false" aria-controls="menu-list">
          <span class="menu-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="menu-text"><span class="scr">{t("menu")}</span><span class="menu-close" aria-hidden="true">{t("close")}</span></span>
          <span class="menu-company">{tf("company")}<svg viewBox="0 0 8 5" aria-hidden="true"><path d="M.7.7 4 4 7.3.7" /></svg></span>
        </button>
        <nav id="menu-list" class="menu-list" aria-label={t("primary")}>
          {sections.map((id, i) => <a class="menu-sec" href={to(id)} style={`--i:${i}`}><span class="scr">{ts(`sections.${id}`)}</span></a>)}
          <i class="menu-rule" aria-hidden="true" style={`--i:${sections.length}`}></i>
          {pages.map(([href, key], i) => (
            <a class="menu-page" href={localize(href, lang)} style={`--i:${sections.length + 1 + i};--j:${i}`} aria-current={here.startsWith(href) ? "page" : undefined}><span class="scr">{ts(`pages.${key}`)}</span></a>
          ))}
        </nav>
      </div>
    </div>
    <a class="btn btn-fill hdr-cta" href={home ? "#summit" : localize("/contact-us/", lang)}><span class="scr">{t("start")}</span></a>
  </div>
</header>
<div class="hdr-ground" aria-hidden="true"></div>
{/* phones: the header has no room for the ask, so it waits in the bottom corner, in thumb reach */}
{!here.startsWith("/contact-us/") && <a class="btn fab" href={home ? "#summit" : localize("/contact-us/", lang)}><span class="scr">{ts("pages.contact")}</span></a>}
