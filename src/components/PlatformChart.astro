---
/* The smart-school platform as one architecture chart, from the people down to the devices (newxion.com/solutions diagram).
   It sits under the smart-schools copy on /products/; page.ts builds its tiers in as the page scrolls. */
import { pct } from "../data/site";
import { useT } from "../i18n";

const t = useT(Astro.currentLocale, "platform");
const roles = [
  ["parents", ["parentHub"]],
  ["students", ["buddy", "wellbeing"]],
  ["teachers", ["curriculum"]],
  ["staff", ["reports", "coach"]],
  ["others", ["other"]],
] as const;
// the agents ring the supervisor: [id, column, row] in a 3×3 hub with the supervisor at the centre
const agents = [
  ["policy", 1, 1],
  ["buddy", 2, 1],
  ["reports", 3, 1],
  ["wellbeing", 1, 3],
  ["attendance", 3, 3],
] as const;
const aiServices = ["speech", "ml"] as const;
const appServices = ["mcp", "backend"] as const;
const infra = [
  ["network", ["auth", "gateway", "iot", "edge"]],
  ["data", ["ingestion", "storage", "transformation", "governance"]],
] as const;
const devices = ["robot", "screens", "watch", "camera", "sensor"] as const; // each id names its dot icon too
---
<figure class="strata-chart">
  <div class="chart">
    <div class="tier">
      <h3 class="tier-label">{t("tiers.users")}</h3>
      <ul class="role-grid">
        {roles.map(([role, apps]) => (
          <li class="role-col">
            <h4>{t(`roles.${role}`)}</h4>
            <ul class="blocks" aria-label={t("appsOf", { role: t(`roles.${role}`) })}>{apps.map((a) => <li>{t(`apps.${a}`)}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
    <div class="tier">
      <h3 class="tier-label">{t("tiers.services")}</h3>
      <div class="services">
        <div class="group group-ai">
          <h4 class="group-name">{t("groups.ai")}</h4>
          <ul class="blocks">{aiServices.map((s) => <li>{t(`aiServices.${s}`)}</li>)}</ul>
        </div>
        <div class="group group-agents">
          <h4 class="group-name">{t("groups.agents")}</h4>
          <div class="hub">
            <svg class="spokes" aria-hidden="true">
              {agents.map(([, c, r]) => <line class="spoke" x1="50%" y1="50%" x2={pct((c - 0.5) / 3)} y2={pct((r - 0.5) / 3)} pathLength="1" />)}
            </svg>
            <p class="supervisor">{t("supervisor")}</p>
            <ul class="hub-agents" aria-label={t("routedTo")}>
              {agents.map(([id, c, r]) => <li class="agent" style={`--c:${c};--r:${r}`}>{t(`agents.${id}`)}</li>)}
            </ul>
            <p class="hub-note">{t("routes")}</p>
          </div>
        </div>
        <div class="group group-app">
          <h4 class="group-name">{t("groups.app")}</h4>
          <ul class="blocks">{appServices.map((s) => <li>{t(`appServices.${s}`)}</li>)}</ul>
        </div>
      </div>
    </div>
    <div class="tier">
      <h3 class="tier-label">{t("tiers.infra")}</h3>
      <div class="infra">
        {infra.map(([name, parts], i) => (
          <div class="group">
            <h4 class="group-name">{t(`infra.${name}`)}</h4>
            <ul class:list={["blocks", "blocks-row", { pipeline: i === 1 }]}>{parts.map((p) => <li>{t(`parts.${p}`)}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
    <div class="tier">
      <h3 class="tier-label">{t("tiers.devices")}</h3>
      <ul class="devices">
        {devices.map((id) => <li><span class="device-icon" data-icon={id}></span>{t(`devices.${id}`)}</li>)}
      </ul>
    </div>
  </div>
  <figcaption>{t("caption")}</figcaption>
</figure>
