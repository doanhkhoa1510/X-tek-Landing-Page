---
import { cities, company, legal, mark, pct, phones } from "../data/site";

interface Props { home?: boolean }
const { home = false } = Astro.props;
const to = (id: string) => (home ? `#${id}` : `/#${id}`);
const explore = [["routes", "Services"], ["ascent", "Process"], ["camps", "Base camps"], ["faq", "FAQ"]];
---
<footer class="foot" data-on="light">
  <div class="wrap foot-grid">
    <div class="foot-map">
      <canvas class="dotmap" data-dotmap="#c9d2e3" aria-hidden="true"></canvas>
      {cities.map((c) => <i class="map-dot" style={`--x:${pct(c.x)};--y:${pct(c.y)}`}></i>)}
    </div>
    <div class="foot-col">
      <p class="label">Base camps</p>
      <address>Dallas, Texas, USA</address>
      <address>Viettel Tower, Floor 12, 285 CMT8, Ho Chi Minh City</address>
      <address>Floor 15, B1 Building, 279 Nguyen Tri Phuong, Da Nang</address>
    </div>
    <div class="foot-col">
      <p class="label">Call</p>
      <a href={phones.us.href} data-scramble><span class="scr">{phones.us.label}</span></a>
      <a href={phones.vn.href} data-scramble><span class="scr">{phones.vn.label}</span></a>
    </div>
    <nav class="foot-col" aria-label="Landing page">
      <p class="label">Explore</p>
      {explore.map(([id, name]) => <a href={to(id)} data-scramble><span class="scr">{name}</span></a>)}
    </nav>
    <nav class="foot-col" aria-label="Company">
      <p class="label">Company</p>
      {company.map(([href, name]) => <a href={href} data-scramble><span class="scr">{name}</span></a>)}
    </nav>
  </div>
  <p class="foot-word" aria-hidden="true"><svg viewBox="0 30 294 162" set:html={mark}></svg>XionTechs</p>
  <dl class="wrap entry" aria-label="How to say XionTechs">
    <dt class="entry-word">Xi·on·techs</dt>
    <dd class="entry-ipa"><span class="say">/siː.ɒn.teks/</span><i>noun</i></dd>
    <dd class="entry-sound">Say it: <b>see</b> · <b>on</b> · <b>techs</b></dd>
    <dd class="entry-def">Named for Mount Zion, the legendary mountain. The team that takes a product from base camp to summit.</dd>
  </dl>
  <div class="wrap foot-legal">
    <span>© 2026 XionTechs · Get IT Done</span>
    <span>Tech made simple, solutions made powerful</span>
    <nav class="foot-legal-links" aria-label="Legal">
      {legal.map(([href, name]) => <a href={href}>{name}</a>)}
    </nav>
    <a href="#top" class="to-top" data-scramble><span class="scr">Back to base camp</span></a>
  </div>
</footer>
