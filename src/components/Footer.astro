---
import { brand, cities, company, email, legal, mark, offices, pct, phones } from "../data/site";
import LangSwitch from "./LangSwitch.astro";
import { localize } from "../i18n/config";
import { useT } from "../i18n";

interface Props { home?: boolean }
const { home = false } = Astro.props;
const lang = Astro.currentLocale;
const t = useT(lang, "footer"), ts = useT(lang, "site");
const to = (id: string) => (home ? `#${id}` : `${localize("/", lang)}#${id}`);
const explore = ["work", "faq", "camps"] as const;
---
<footer class="foot" data-on="light">
  <div class="wrap foot-grid">
    <div class="foot-map">
      <canvas class="dotmap" data-dotmap="#c9d2e3" aria-hidden="true"></canvas>
      {cities.map((c) => <i class="map-dot" style={`--x:${pct(c.x)};--y:${pct(c.y)}`}></i>)}
    </div>
    <div class="foot-col">
      <p class="label">{t("camps")}</p>
      {offices.map((o) => <address>{o.lines.length > 0 ? <bdi>{o.lines.join(", ")}</bdi> : ts(`offices.${o.id}.name`)}</address>)}
    </div>
    <div class="foot-col">
      <p class="label">{t("reach")}</p>
      <a href={phones.us.href}><span class="scr">{phones.us.label}</span></a>
      <a href={phones.wa.href} target="_blank" rel="noopener"><span class="scr">{t("whatsapp")}</span></a>
<!--email_off--><a class="foot-mail" href={`mailto:${email}`}>{email.split("@")[0]}@<wbr />{email.split("@")[1]}</a><!--/email_off-->
    </div>
    <nav class="foot-col" aria-label={t("landing")}>
      <p class="label">{t("explore")}</p>
      {explore.map((id) => <a href={to(id)}><span class="scr">{ts(`sections.${id}`)}</span></a>)}
    </nav>
    <nav class="foot-col" aria-label={t("company")}>
      <p class="label">{t("company")}</p>
      {company.map(([href, key]) => <a href={localize(href, lang)}><span class="scr">{ts(`pages.${key}`)}</span></a>)}
    </nav>
  </div>
  <p class="foot-word" aria-hidden="true"><svg viewBox="0 30 294 162" set:html={mark}></svg>{brand.name}</p>
  <dl class="wrap entry" aria-label={t("entry.label", { brand: brand.name })}>
    <dt class="entry-word">{brand.dict}</dt>
    <dd class="entry-ipa"><span class="say">{brand.ipa}</span><i>{t("entry.noun")}</i></dd>
    <dd class="entry-sound">{t("entry.sayIt")} {brand.syllables.map((s, i) => <>{i > 0 && " · "}<b>{s}</b></>)}</dd>
    <dd class="entry-def">{t("entry.def")}</dd>
  </dl>
  <LangSwitch variant="row" />
  <div class="wrap foot-legal">
    <span>{t("rights", { year: 2026, brand: brand.name })}</span>
    <span>{t("tagline")}</span>
    <nav class="foot-legal-links" aria-label={t("legal")}>
      {legal.map(([href, key]) => <a href={localize(href, lang)}>{ts(`legal.${key}`)}</a>)}
    </nav>
    <a href="#top" class="to-top"><span class="scr">{t("toTop")}</span></a>
  </div>
</footer>
