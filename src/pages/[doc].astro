---
/* Long-form pages kept from the old site at their old URLs: /support/, /privacy-policy/, /terms-of-service/, /cookie-policy/.
   App store listings link to the support and privacy URLs, so those paths must not move. */
import { getCollection, render } from "astro:content";
import Sub from "../layouts/Sub.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { doc: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const { title, kicker, description, lede, meta } = doc.data;
const toc = headings.filter((h) => h.depth === 2);
---
<Sub title={title.replace(/\.$/, "")} description={description} a={kicker} b={title} lede={lede} meta={meta}>
  <section class="doc" data-on="light" aria-label={title}>
    <div class="wrap doc-grid">
      <nav class="doc-toc" aria-label="On this page">
        <p class="label">On this page</p>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Sub>
