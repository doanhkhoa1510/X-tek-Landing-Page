---
import { getCollection } from "astro:content";
import Sub from "../layouts/Sub.astro";
import Cta from "../components/Cta.astro";

const perks = [
  ["ai", "Innovative environment", "Be inspired by the visionary spirit of Xion as you work with cutting-edge technologies to create transformative IT systems."],
  ["staffing", "Empowering culture", "Be part of a “Beyond Employees Culture” that pairs startup spirit and innovation with a “Get IT Done” mindset, where everyone belongs."],
  ["analytics", "Continuous growth", "Role-specific onboarding helps you succeed from day one, backed by structured training and knowledge resources."],
  ["development", "Tech that excites", "Tackle challenging projects with AI/ML, generative AI, cloud computing, and Agile methods in a mature engineering environment."],
  ["target", "Real impact", "Build secure, high-quality solutions that drive digital transformation for businesses and innovators worldwide."],
];

// the old board keeps its closed posts; all five closed on the same day
const jobs = (await getCollection("jobs")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Sub
  title="Careers"
  description="Join XionTechs in Ho Chi Minh City: a forward-thinking team where innovation and collaboration thrive."
  a="Careers."
  b="Job finds talent."
  lede="At XionTechs, you are part of a forward-thinking team where innovation and collaboration thrive: an inspiring, inclusive place built for growth, where you own impactful work."
>
  <section class="roles" data-on="light" aria-labelledby="roles-title">
    <div class="wrap split">
      <div>
        <h2 id="roles-title" class="tt"><span class="tt-a">Open roles.</span> <span class="tt-b">None right now.</span></h2>
        <p class="split-note">Be patient: a new recruitment campaign starts soon.</p>
      </div>
      <div class="split-body">
        <p class="label roles-label">Past roles · {jobs[0]?.data.category}</p>
        <ul class="role-list">
          {jobs.map((j) => (
            <li>
              <a class="role" href={`/job/${j.id}/`} data-cursor-label="Read the role">
                <h3>{j.data.title}</h3>
                <span class="role-meta">{j.data.type} · Ho Chi Minh City · Closed {j.data.validThrough}</span>
                <span class="role-go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" /></svg></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="perks" data-on="light" aria-labelledby="perks-title">
    <div class="wrap split-head">
      <h2 id="perks-title" class="tt"><span class="tt-a">Why join us?</span> <span class="tt-b">A beyond-employees culture.</span></h2>
    </div>
    <ul class="wrap cells cells-5">
      {perks.map(([icon, name, text]) => (
        <li class="cell">
          <span class="cell-icon" data-icon={icon}></span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </section>

  <Cta a="Next campaign." b="Send us your resume." href="mailto:recruit@xiontechs.com" label="recruit@xiontechs.com" call={false} />
</Sub>
