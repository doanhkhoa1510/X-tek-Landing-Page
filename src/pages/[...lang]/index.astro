---
import Base from "../../layouts/Base.astro";
import Loader from "../../components/sections/Loader.astro";
import Hero from "../../components/sections/Hero.astro";
import Services from "../../components/sections/Services.astro";
import Work from "../../components/sections/Work.astro";
import Why from "../../components/sections/Why.astro";
import Faq from "../../components/sections/Faq.astro";
import Camps from "../../components/sections/Camps.astro";
import Summit from "../../components/sections/Summit.astro";
import { brand, services } from "../../data/site";
import { localePaths } from "../../i18n/config";
import { useT } from "../../i18n";
import { SUMMIT_M } from "../../scripts/relief";

export const getStaticPaths = localePaths;

// content follows newxion.com; the flow is Main → Services → The log (customers, products, done, achieved) → Why XionTech → FAQ → Contact.
// The story of Xion and the seven core values live on About us (#36), so the landing page says what XionTech does first.
const lang = Astro.currentLocale;
const t = useT(lang, "home");
// mountain.ts labels its chips from data-labels: the waypoints are the five services, in their short form
const chips = { ...Object.fromEntries(services.map((id) => [id, t(`waypoints.${id}`)])), summit: t("summit", { m: SUMMIT_M }) };
---
<Base title={t("title", { brand: brand.name })} description={t("description")} home>
<!--
THESIS: The mountain is XionTech's symbol and goal (the name is inspired by Mount Zion, named once in the story, never in a label); the page is the climb. It refuses the stock hero and card grid: the company is a mountain, its values are what the team carries up, and its record is a log read entry by entry on a dial.
OWN-WORLD: Night at base camp (#030813), a white-dot particle mountain (real SRTM relief) with an amber dawn behind the ridge and a glacier-blue rim, then dawn hands over to snow-white daylight. Saira at 125% width, uppercase and two-tone; Martian Mono for controls and readings; pill buttons; hairlines; dot-matrix icons.
STORY: A B2B buyer meets XionTech, sees what they can hire it for and the platform it built, walks the log (customers, products, done, achieved), gets answers, sees the base camps (Plano, TX, Ho Chi Minh City, and Da Nang), and names their summit in the brief.
FIRST VIEWPORT: The mountain fills the right two-thirds with five waypoint chips, one per service (no city names: the offices wait for Contact); the four-line headline sits bottom-left with the lede under it (the brief CTA lives in the header); a live-clock ticker tops the header.
FORM: Brief-pinned (unitedcarriers.com mechanics, globe replaced by a mountain). Seed bb9e9a62.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->
  <Fragment slot="stage">
    <Loader />
    <canvas id="mountain" aria-hidden="true"></canvas>
    <div id="chips" class="chips" aria-hidden="true" data-labels={JSON.stringify(chips)}></div>
  </Fragment>

  <Hero />
  <Services />
  <Work />
  <Why />
  <Faq />
  <Camps />
  <Summit />

  <Fragment slot="script">
    <script>
      // the first frame paints before the scenes load: the loader (CSS only) and, under it, the hero copy
      const start = () => requestAnimationFrame(() => setTimeout(() => {
        document.getElementById("fonts")?.setAttribute("media", "all");
        import("../../scripts/app");
      }));
      if (document.hidden) {
        // a tab opened in the background runs nothing (no three.js, no GSAP) and holds the loader's entrance until it is shown
        const held = document.getAnimations();
        held.forEach((a) => a.pause());
        document.addEventListener("visibilitychange", () => {
          held.forEach((a) => a.play());
          start();
        }, { once: true });
      } else start();
    </script>
  </Fragment>
</Base>
