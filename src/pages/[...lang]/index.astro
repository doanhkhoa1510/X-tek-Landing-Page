---
import Base from "../../layouts/Base.astro";
import Loader from "../../components/sections/Loader.astro";
import Hero from "../../components/sections/Hero.astro";
import Mindset from "../../components/sections/Mindset.astro";
import Values from "../../components/sections/Values.astro";
import Platform from "../../components/sections/Platform.astro";
import Work from "../../components/sections/Work.astro";
import Faq from "../../components/sections/Faq.astro";
import Camps from "../../components/sections/Camps.astro";
import Summit from "../../components/sections/Summit.astro";
import { brand, cities } from "../../data/site";
import { localePaths } from "../../i18n/config";
import { useT } from "../../i18n";
import { SUMMIT_M } from "../../scripts/relief";

export const getStaticPaths = localePaths;

// content follows newxion.com; the flow is Main → Mindset and core values → Platform → The log (achieved, done, products, customers) → FAQ → Contact
const lang = Astro.currentLocale;
const t = useT(lang, "home"), ts = useT(lang, "site");
// mountain.ts labels its chips from data-labels
const chips = { ...Object.fromEntries(cities.map((c) => [c.id, ts(`cities.${c.id}.name`)])), summit: t("summit", { m: SUMMIT_M }) };
---
<Base title={t("title", { brand: brand.name })} description={t("description")} home>
<!--
THESIS: The mountain is XionTechs' symbol and goal (the name is inspired by Mount Zion, named once in the story, never in a label); the page is the climb. It refuses the stock hero and card grid: the company is a mountain, its values are what the team carries up, and its record is a trek read camp by camp on an altimeter.
OWN-WORLD: Night at base camp (#030813), a white-dot particle mountain (real SRTM relief) with an amber dawn behind the ridge and a glacier-blue rim, then dawn hands over to snow-white daylight. Saira at 125% width, uppercase and two-tone; Martian Mono for controls and readings; pill buttons; hairlines; dot-matrix icons.
STORY: A B2B buyer meets XionTechs, reads the mindset of Xion and its seven core values, walks the log (achieved, done, products, customers), gets answers, sees the base camps (Plano, TX, Ho Chi Minh City, and Da Nang), and names their summit in the brief.
FIRST VIEWPORT: The mountain fills the right two-thirds with Plano, HCMC, and Da Nang chips; the four-line headline sits bottom-left with Talk to our experts under it; a live-clock ticker tops the header.
FORM: Brief-pinned (unitedcarriers.com mechanics, globe replaced by a mountain). Seed bb9e9a62.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->
  <Fragment slot="stage">
    <Loader />
    <canvas id="mountain" aria-hidden="true"></canvas>
    <div id="chips" class="chips" aria-hidden="true" data-labels={JSON.stringify(chips)}></div>
  </Fragment>

  <Hero />
  <Mindset />
  <Values />
  <Platform />
  <Work />
  <Faq />
  <Camps />
  <Summit />

  <Fragment slot="script">
    <script>
      import "../../scripts/app";
    </script>
  </Fragment>
</Base>
