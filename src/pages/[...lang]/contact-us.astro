---
/* Contact stays on night from head to form, like the summit: the brief is the last thing asked before daylight. */
import Sub from "../../layouts/Sub.astro";
import { arc, cities, email, MAP_H, MAP_W, offices, pct, phones, services } from "../../data/site";
import { localePaths } from "../../i18n/config";

export const getStaticPaths = localePaths;

const maps = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
const subjects = services.map(([name]) => name);
const [plano, hcm, dan] = cities;
---
<Sub
  title="Contact us"
  description={`Request services from XionTechs: offices in Plano, Texas, Ho Chi Minh City, and Da Nang. Call ${phones.us.label} or email ${email}.`}
  a="Contact us."
  b="Request for services."
  lede="Tell us what you are building and where you want it to be. We reply by email."
  dawn={false}
>
  <section class="contact" data-on="dark" aria-label="Offices and request form">
    <div class="wrap contact-grid">
      <div class="contact-info">
        <div class="contact-block">
          <p class="label">Our addresses</p>
          {offices.map((o) => (
            <div class="office">
              <h2>{o.name}</h2>
              <address>{o.role}{o.lines.map((l) => <><br />{l}</>)}</address>
              {o.lines.length > 0 && <a href={maps(o.lines.join(", "))} target="_blank" rel="noopener" data-scramble><span class="scr">Open in maps</span></a>}
            </div>
          ))}
        </div>
        <div class="contact-block">
          <p class="label">Call us anytime</p>
          <a class="contact-line" href={phones.us.href} data-scramble><span class="scr">{phones.us.label}</span></a>
          <a class="contact-line" href={phones.wa.href} target="_blank" rel="noopener" data-scramble><span class="scr">WhatsApp {phones.wa.label}</span></a>
        </div>
        <div class="contact-block">
          <p class="label">Send an email</p>
          <a class="contact-line" href={`mailto:${email}`} data-scramble><span class="scr">{email}</span></a>
        </div>
      </div>

      <form class="brief contact-form" novalidate data-endpoint="">
        <div class="brief-row">
          <label>Your name<input name="name" autocomplete="name" required /></label>
          <label>Work email<input name="email" type="email" autocomplete="email" required /></label>
        </div>
        <div class="brief-row">
          <label>Subject
            <select name="subject">
              <option value="">Choose a service</option>
              {subjects.map((s) => <option>{s}</option>)}
            </select>
          </label>
          <label>Phone <span class="opt">optional</span><input name="phone" type="tel" autocomplete="tel" /></label>
        </div>
        <label>What are you building?<textarea name="msg" rows="4" required></textarea></label>
        <p class="form-status" role="status" aria-live="polite"></p>
        <button class="btn btn-fill" type="submit" data-scramble><span class="scr">Send request</span></button>
      </form>
    </div>

    <div class="wrap">
      <div class="worldmap contact-map">
        <canvas class="dotmap" data-dotmap="#1f3566" aria-hidden="true"></canvas>
        <svg class="worldmap-arcs" viewBox={`0 0 ${MAP_W} ${MAP_H.toFixed(1)}`} preserveAspectRatio="none" aria-hidden="true">
          <path class="arc-base" d={arc(plano, hcm, 110)} pathLength="1" />
          <path class="arc-run" d={arc(plano, hcm, 110)} pathLength="1" />
          <path class="arc-base" d={arc(hcm, dan, 30)} pathLength="1" />
          <path class="arc-run arc-run-short" d={arc(hcm, dan, 30)} pathLength="1" />
        </svg>
        {cities.map((c) => (
          <div class={`city city-${c.id}`} data-cursor-label={c.name} style={`--x:${pct(c.x)};--y:${pct(c.y)}`}>
            <span class="city-chip"><b>{c.name}</b> <span data-clock={c.zone}>--:--</span> {c.abbr}</span>
            <i class="city-dot"></i>
          </div>
        ))}
      </div>
    </div>
    <div class="horizon dawn" aria-hidden="true"></div>
  </section>
</Sub>
