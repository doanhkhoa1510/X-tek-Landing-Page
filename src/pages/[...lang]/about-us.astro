---
import Sub from "../../layouts/Sub.astro";
import Cta from "../../components/Cta.astro";
import Leaders from "../../components/Leaders.astro";
import Mindset from "../../components/sections/Mindset.astro";
import Values from "../../components/sections/Values.astro";
import { localePaths } from "../../i18n/config";
import { useT } from "../../i18n";

export const getStaticPaths = localePaths;

const t = useT(Astro.currentLocale, "about");

// [id, counted number, unit]: only figures in PRODUCT.md › Evidence on Hand, the same numbers the landing page shows (#44)
const figures = [
  ["years", "25", "+"],
  ["pillars", "5", ""],
  ["offices", "3", ""],
  ["services", "5", ""],
  ["products", "2", ""],
] as const;

const reasons = ["client", "integrity", "quality", "rapid", "reliable", "team"] as const;
---
<Sub title={t("title")} description={t("description")} a={t("head.a")} b={t("head.b")} lede={t("lede")}>
  <!-- the story of Xion and the seven core values, moved here from the landing page (#36) -->
  <Mindset />
  <Values />

  <section class="facts" data-on="light" aria-label={t("figures.label")}>
    <dl class="wrap figures">
      {figures.map(([id, n, unit]) => (
        <div class="stat"><dt>{t(`figures.items.${id}`)}</dt><dd>{n && <span data-count={n}>{n}</span>}{unit}</dd></div>
      ))}
    </dl>
  </section>

  <Leaders />

  <section class="why" data-on="light" aria-labelledby="why-title">
    <div class="wrap split">
      <h2 id="why-title" class="tt"><span class="tt-a">{t("why.title.a")}</span> <span class="tt-b">{t("why.title.b")}</span></h2>
      <div class="split-body">
        <p class="lede">{t("why.lede")}</p>
        <ul class="ticks">
          {reasons.map((id) => <li>{t(`why.reasons.${id}`)}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Cta />
</Sub>
