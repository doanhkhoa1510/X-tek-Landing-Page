---
import Sub from "../layouts/Sub.astro";
import Cta from "../components/Cta.astro";

const values = [
  ["rocket", "Startup spirit", "Entrepreneurial and agile."],
  ["target", "Client centricity", "Outcomes focused for clients."],
  ["shield", "Integrity mindset", "Honesty and transparency."],
  ["ai", "Innovation passion", "Stay ahead of the curve."],
  ["check", "“Get IT Done” attitude", "Ownership and commitment."],
  ["home", "Beyond employees culture", "A culture of home feeling."],
];

const figures: [string, string, string][] = [
  ["25", "", "Years of experience"],
  ["100", "%", "Client commitment"],
  ["", "24/7", "Global coverage"],
  ["5", "+", "Industry verticals"],
  ["8", "+", "Service offerings"],
];

const reasons = ["Client centricity focus", "Integrity and ethical standards", "High quality delivery", "Rapid product engineering", "Reliable solutions", "24/7 expert team"];
---
<Sub
  title="About us"
  description="XionTechs distinguishes itself through its dedication to its people, and to the processes and technology they work with: six core values and one “Get IT Done” attitude."
  a="About us."
  b="We are increasing business success with IT solutions."
  lede="XionTechs distinguishes itself through its dedication to its people, and to the processes and technology they work with, as the core values below show."
>
  <section class="values" data-on="light" aria-labelledby="values-title">
    <div class="wrap split-head">
      <h2 id="values-title" class="tt"><span class="tt-a">Core values.</span> <span class="tt-b">People, processes, technology.</span></h2>
    </div>
    <ul class="wrap cells cells-3">
      {values.map(([icon, name, text]) => (
        <li class="cell">
          <span class="cell-icon" data-icon={icon}></span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
    <dl class="wrap figures" aria-label="XionTechs in figures">
      {figures.map(([n, unit, label]) => (
        <div class="stat"><dt>{label}</dt><dd>{n && <span data-count={n}>{n}</span>}{unit}</dd></div>
      ))}
    </dl>
  </section>

  <section class="why" data-on="light" aria-labelledby="why-title">
    <div class="wrap split">
      <h2 id="why-title" class="tt"><span class="tt-a">Why choose us.</span> <span class="tt-b">Professional IT services, every aspect.</span></h2>
      <div class="split-body">
        <p class="lede">Choose XionTechs for integrated solutions backed by industry experience and metric-driven delivery. We bring product ideas to life through collaborative creation and a “Get IT Done” attitude.</p>
        <ul class="ticks">
          {reasons.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Cta />
</Sub>
