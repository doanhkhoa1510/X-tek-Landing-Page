# Public origin of the site, used for canonical and hreflang links. No trailing slash.
SITE_URL=https://xiontechs.persiehomeserver.top

# ---- docker compose (compose.yaml) ----
# host port for the site
WEB_PORT=8080
# where briefs from the site's form arrive; several addresses: comma-separated
CONTACT_TO=thinhdpham2510@gmail.com
# the domain briefs are sent from (no-reply@MAIL_DOMAIN); Postfix signs it with DKIM
MAIL_DOMAIN=xiontechs.persiehomeserver.top
# the name Postfix greets with; for direct delivery it must match the server IP's reverse DNS (PTR)
# MAIL_HOSTNAME=mail.xiontechs.persiehomeserver.top

# Direct delivery (RELAYHOST empty) needs outbound port 25 open, a PTR record, an SPF record for
# MAIL_DOMAIN that allows the server IP, and the DKIM record Postfix prints on first start.
# Home and cloud networks often block port 25: then relay through an SMTP account, e.g. Gmail
# with an app password (https://myaccount.google.com/apppasswords):
# RELAYHOST=[smtp.gmail.com]:587
# RELAYHOST_USERNAME=you@gmail.com
# RELAYHOST_PASSWORD=your-app-password

# images to pull instead of building (docker compose pull)
# WEB_IMAGE=user/xiontechs-landing:latest
# MAILER_IMAGE=user/xiontechs-landing-mailer:latest
